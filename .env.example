# Local development only. Copy to .env; do not commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=siniear
DB_USER=siniear
DB_PASSWORD=replace-with-local-password

APP_ENV=development
INTERNAL_INBOUND_TOKEN=
INTERNAL_OUTBOUND_TOKEN=
INTERNAL_SCOPES=calls:execute
PEER_BASE_URL=http://127.0.0.1:8000
CALL_PROVIDER=disabled
ALLOW_PAID_CALLS=false
PUBLIC_BASE_URL=
KOREAAITEL_ACCOUNT_ID=
KOREAAITEL_API_KEY=
KOREAAITEL_SIGNING_KEY=
KOREAAITEL_FROM_NUMBER=
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_SUMMARY_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Provisional implementation value; real Korean retrieval quality is not evaluated.
MEMORY_MIN_SCORE=0.75
